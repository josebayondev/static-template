---
import '../styles/global.css';

const title = 'Static template';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="flex min-h-dvh items-center justify-center bg-surface text-content">
    <main class="text-center">
      <h1 class="text-4xl font-bold">{title}</h1>
      <p class="mt-2 text-content-muted">Astro 7 + Tailwind 4. Empieza por aqui.</p>
    </main>
  </body>
</html>
