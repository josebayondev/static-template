# Copia este fichero a .env y ajusta los valores.
#
# Solo las variables con prefijo PUBLIC_ llegan al navegador, asi que aqui
# nunca va un secreto. Este sitio es estatico: todo lo que se compila es
# publico por definicion.
#
# La plantilla llega vacia: estas son las variables que suele necesitar un
# sitio de cliente. Borra las que no uses.

# Endpoint del formulario de contacto (Web3Forms o Formspree).
PUBLIC_CONTACT_ENDPOINT=
PUBLIC_CONTACT_ACCESS_KEY=

# Analitica cookieless. Vacio = sin analitica (no se inyecta ningun script).
PUBLIC_ANALYTICS_DOMAIN=
PUBLIC_ANALYTICS_SRC=
